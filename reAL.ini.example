; reAL configuration
; Global location: C:\windows\reAL.ini  (in a Wine prefix: drive_c/windows/reAL.ini)
; Also read, in order (later wins): <dsound.dll dir>\dsound.ini (ALchemy format), <game dir>\reAL.ini,
; and the file named by the REAL_INI environment variable. REAL_LOG=0..3 overrides "log".
;
; Keys outside a section and in [default] apply to every game; a [game.exe] section overrides
; them for that executable only (case-insensitive).

[default]
; WASAPI buffer length in ms. 0/unset = buffers*duration/2 (50 ms with ALchemy's defaults).
latency=0
; ALchemy-compatible keys (same meaning and limits as ALchemy's dsound.ini)
buffers=4
duration=25
maxvoicecount=128
disabledirectmusic=false

; resampling of buffers that play at a different rate than the output: sinc (default, clean) or
; linear (what ALchemy does: duller top end, audible aliasing on low-rate sounds)
resampler=sinc

; logging: 0 off, 1 info, 2 API calls, 3 everything (per Lock/Play - very verbose)
log=0
log3d=false
logeax=false
; default log file: reAL.log next to the game's exe
;logfile=C:\reAL.log

; enabled=false hands everything to the original dsound.dll named by realdsound=
; (only useful when reAL is installed per-game, not as the system dsound.dll)
;enabled=true
;realdsound=C:\windows\system32\dsound_orig.dll
; DirectMusic games under Wine: Microsoft's DirectMusic (winetricks directmusic) needs two private
; DirectSound interfaces that Wine's dsound lacks. reAL passes them to the real dsound, so point
; realdsound= at Microsoft's dsound.dll for those games (confirmed with Midnight Club II).
; disabledirectmusic=true refuses them, as in ALchemy.

; reAL-Music: reAL's own DirectMusic (loader, performance, segments, DLS synth, Waves reverb), played
; through reAL instead of Microsoft's DirectMusic. Needs nothing from Microsoft except the GM collection.
;music=true
; GM instrument collection: by default DirectMusic's own gm.dls (registry GMFilePath, else
; system32\drivers\gm.dls, also outside WOW64 redirection, then the game's folder). Point this at another
; DLS file or at a SoundFont (.sf2), absolute or relative to the game's folder, to use a custom one.
;gmdls=D:\Sound\MyGM.dls
; MIDI music (games that play General MIDI through Windows' MIDI API, e.g. Claw): midi=true adds the
; "reAL-Music GM Synth" output and makes it the MIDI mapper, so the game's music plays through reAL with
; the GM collection above (gm.dls or gmdls=). midirate= sets its sample rate (default 22050),
; midireverb=false turns its reverb off. miditrace=true logs every MIDI / MCI call the game makes.
;midi=true
;miditrace=true

; per-game examples
[EverQuest2.exe]
duration=15

[mc2.exe]
music=true

[CLAW.EXE]
midi=true

[SplinterCell.exe]
buffers=6
